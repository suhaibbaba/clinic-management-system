# Kossai Jarrar's clinic: its own database, object store and containers beside the sandbox.
# On the server: cd /opt/clinic/kossai-jarrar && cp .env.kossai-jarrar.example .env && chmod 600 .env
# Every CHANGE_ME is a placeholder. Secrets: openssl rand -base64 48 / openssl rand -hex 24. See DEPLOY.md.

#   openssl rand -base64 48   # JWT_SECRET, BOOKING_TOKEN_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD, STORAGE_SECRET_ACCESS_KEY

# ─────────────────────────── The stack ────────────────────────────

# The Compose project, image prefix and loopback ports; the sandbox keeps the defaults
# (clinic-sandbox, 15000/15080/15900). The deploy runs it as -p clinic-kossai-jarrar.
STACK_NAME=clinic-kossai-jarrar
API_PORT=16000
WEB_PORT=16080
S3_PORT=16900

# ─────────────────────────── PostgreSQL ───────────────────────────

POSTGRES_USER=clinic
# No host port, but use a real password.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=clinic

# ───────────────────────────── API ────────────────────────────────

NODE_ENV=production
# Inside the container; the host port is API_PORT above.
PORT=3000
HOST=0.0.0.0
# Keep in step with the credentials above.
DATABASE_URL=postgres://clinic:CHANGE_ME_postgres_password@postgres:5432/clinic
DATABASE_POOL_MAX=10
# Optional least-privilege roles, see DEPLOY.md.
# MIGRATION_DATABASE_URL=postgres://clinic:CHANGE_ME_postgres_password@postgres:5432/clinic
# APP_DATABASE_ROLE=clinic_app
# APP_DATABASE_PASSWORD=CHANGE_ME_app_password
# Only for tools calling the API directly; the web app is same-origin.
CORS_ORIGIN=https://admin.kossai-jarrar.organza-moda.com
LOG_LEVEL=log
# Proxies trusted for X-Forwarded-For (names or CIDRs).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Per user, or per IP when signed out.
THROTTLE_LIMIT_PER_MINUTE=600
# Generate one; never reuse the development placeholder.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_PATH=/
# Served over https, so the cookie is Secure. Leave it.
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_SAMESITE=lax

# ─────────────────────── Object storage (MinIO) ───────────────────

# The PUBLIC S3 address: presigned URLs are signed for it. Not http://minio:9000.
STORAGE_ENDPOINT=https://kossai-jarrar-s3.organza-moda.com
STORAGE_REGION=auto
STORAGE_BUCKET=clinic-files
# Also the MinIO root credentials.
STORAGE_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
STORAGE_FORCE_PATH_STYLE=true
# Presigned URL lifetimes, in seconds.
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# ─────────────────────── Notifications ────────────────────────────

# log until the clinic's WhatsApp sender is set up: nothing is texted, and sign-in codes only
# reach the API log, which is why the admin starts with BOOTSTRAP_ADMIN_PASSWORD.
NOTIFICATIONS_PROVIDER=log
# NOTIFICATIONS_HTTP_URL=
# NOTIFICATIONS_HTTP_TOKEN=
NOTIFICATIONS_HTTP_TIMEOUT_MS=5000
# For whatsapp: all three are needed.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_CODE_TEMPLATE_NAME=clinic_otp
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ───────────────────────── Email ──────────────────────────────────

# log | resend. log prints the email to the API log and sends nothing.
EMAIL_PROVIDER=log
# From https://resend.com, needed for resend.
# RESEND_API_KEY=CHANGE_ME_resend_api_key
# Its domain must be verified with the provider. resend.dev only reaches the key's owner.
EMAIL_FROM=Clinic <onboarding@resend.dev>
EMAIL_LINK_TTL_HOURS=48

# ─────────────────────── Sign-in options ──────────────────────────

# Google sign-in, off until both are set.
# Redirect URI: https://admin.kossai-jarrar.organza-moda.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Passkeys use the PUBLIC_BASE_URL host; no setting needed.

# ────────────────────── Public booking ────────────────────────────

# Its own key, not JWT_SECRET.
BOOKING_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# The dashboard's address: sign-in, passkeys and Google come back here.
PUBLIC_BASE_URL=https://admin.kossai-jarrar.organza-moda.com

# ───────────────────────── AI assistant ───────────────────────────

# log | openai. log answers with a fixed line and calls nobody.
AI_PROVIDER=log
# Needed for openai. Billed per use.
# OPENAI_API_KEY=CHANGE_ME_openai_api_key
AI_MODEL=gpt-5.6-luna
# Must stay none while the API uses Chat Completions.
AI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_MS=30000
# Past messages sent to the model.
AI_HISTORY_MESSAGES=20
# Tool-call rounds per question.
AI_MAX_TOOL_STEPS=5
# Questions per user per hour.
AI_RATE_LIMIT_PER_HOUR=30
# Tokens per clinic per day.
AI_DAILY_TOKEN_BUDGET=200000
# How long a drafted bulk message waits to be sent.
AI_PROPOSAL_TTL_MINUTES=15
# Clinic-local hour the daily automation runs.
AI_AUTOMATION_HOUR=9
# Encrypts keys saved in the assistant settings: openssl rand -base64 32
# SECRETS_MASTER_KEY=

# ─────────────────────────── The clinic ───────────────────────────

# A real clinic: never the demo seed.
SEED_ON_BOOT=false
# Creates the clinic and its first admin from BOOTSTRAP_* after migrations, once. Every later boot
# leaves the clinic, its admin and the admin's password as they are, so these can stay set.
BOOTSTRAP_ON_BOOT=true
BOOTSTRAP_CLINIC_SLUG=kossai-jarrar
BOOTSTRAP_CLINIC_NAME_AR=عيادة د. قصي جرار
BOOTSTRAP_CLINIC_NAME_EN=Dr. Kossai Jarrar Clinic
# dental | orthopedic, comma-separated.
BOOTSTRAP_SPECIALTIES=orthopedic
# Paid modules, comma-separated: website, assistant.
BOOTSTRAP_MODULES=website
# The public website's host, without www. or a port; the dashboard is admin. of it.
BOOTSTRAP_SITE_DOMAIN=kossai-jarrar.organza-moda.com
BOOTSTRAP_CURRENCY=ILS
BOOTSTRAP_COUNTRY=PS
BOOTSTRAP_TIMEZONE=Asia/Hebron
BOOTSTRAP_ADMIN_FIRST_NAME_AR=قصي
BOOTSTRAP_ADMIN_LAST_NAME_AR=جرار
BOOTSTRAP_ADMIN_FIRST_NAME_EN=Kossai
BOOTSTRAP_ADMIN_LAST_NAME_EN=Jarrar
# International format. The admin signs in with this phone (or the email) and the password below.
BOOTSTRAP_ADMIN_PHONE=CHANGE_ME_+970...
# BOOTSTRAP_ADMIN_EMAIL=
# At least 10 characters. Read once, when the admin is created; he changes it from his profile.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_first_password

# ──────────────────────────── Backups ─────────────────────────────

# Nightly pg_dump, UTC, HH:MM.
BACKUP_AT_UTC=02:15
BACKUP_KEEP_DAYS=7
