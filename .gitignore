# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment — secrets never enter the repository. Only the *.example
# templates are committed (.env.example, .env.sandbox.example); every real
# .env, wherever it is deployed, stays out.
.env
.env.*
!.env*.example

# Logs & editor noise
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/

# Screenshots and QA output are never committed, anywhere: visual evidence
# belongs in the pull request description, and docs/ holds source-of-truth
# inputs rather than generated output.
qa/
docs/qa/
docs/**/*.png
