# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
storybook-static/
*.tsbuildinfo

# Environment — secrets never enter the repository. Only the *.example
# templates are committed (.env.example, .env.sandbox.example); every real
# .env, wherever it is deployed, stays out.
.env
.env.*
!.env*.example

# Logs & editor noise
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/

# Visual QA output: screenshots are regenerated by `pnpm qa:screens`, never
# committed. Rooted, so the handful kept as evidence in docs/qa/ still are.
/qa/

# Playwright's own output from `pnpm test:e2e`.
playwright-report/
test-results/
