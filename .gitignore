# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment — secrets never enter the repository. Only the *.example
# templates are committed (.env.example, .env.sandbox.example); every real
# .env, wherever it is deployed, stays out.
.env
.env.*
!.env*.example

# Logs & editor noise
*.log
npm-debug.log*
.DS_Store
.idea/
# The directory rather than the folder, because git cannot re-include a file
# out of an excluded folder: the settings that apply the formatter on save, and
# the extensions behind them, are shared rather than personal.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Screenshots and QA output are never committed, anywhere: visual evidence
# belongs in the pull request description, and docs/ holds source-of-truth
# inputs rather than generated output.
qa/
docs/qa/
docs/**/*.png

# Browser mode writes one on a failed assertion. A picture of a past failure is a
# review artefact, not a fixture — CLAUDE.md keeps them out of the repo.
**/__screenshots__/
apps/web/.vitest-attachments