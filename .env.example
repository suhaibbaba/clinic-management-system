# Copy to .env before starting the stack:
#   cp .env.example .env && docker compose up
#
# Values below are development defaults and are safe to commit. Never commit .env.

# ─────────────────────────── PostgreSQL ───────────────────────────

# Database superuser created on first boot of the postgres container.
POSTGRES_USER=clinic
# Development-only password. Generate a strong one for any deployed environment.
POSTGRES_PASSWORD=clinic_dev_password
# Database created on first boot.
POSTGRES_DB=clinic
# Host port that maps to the container's 5432 (change if 5432 is already taken).
POSTGRES_PORT=5432

# ───────────────────────────── API ────────────────────────────────

# Runtime mode: development | test | production.
NODE_ENV=development
# Port the API listens on inside its container.
PORT=3000
# Host port that maps to the API container's PORT.
API_PORT=3000
# Bind address. 0.0.0.0 so the container is reachable from the Docker network.
HOST=0.0.0.0
# Connection string. The host is the compose service name `postgres`; use
# `localhost` instead when running the API directly on your machine.
DATABASE_URL=postgres://clinic:clinic_dev_password@postgres:5432/clinic
# Maximum pooled connections. Kept small — target infra is a single small VPS.
DATABASE_POOL_MAX=10
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Signing key for access tokens, at least 32 characters. The value below is a
# development placeholder, not a secret — generate a real one per environment
# with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
# Access-token lifetime in seconds. Short by design; the refresh token carries
# the session and is rotated on every use.
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in days.
JWT_REFRESH_TTL_DAYS=30
# Path the httpOnly refresh cookie is scoped to, as the browser sees it. The web
# app reaches the API through a same-origin /api proxy, so "/" covers every
# deployment without coupling the API to the proxy prefix.
AUTH_COOKIE_PATH=/
# Reported by /health so a running build can be identified.
APP_VERSION=0.1.0

# ─────────────────────── Object storage (R2) ──────────────────────

# X-rays and documents live in S3-compatible object storage — Cloudflare R2 in
# production, the `minio` service of the dev stack locally, so nothing here
# needs real R2 credentials. Only keys and metadata are stored in the database;
# files are read and written through short-lived presigned URLs and are never
# public.
#
# For Cloudflare R2, set:
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=false
# and use an R2 API token as the access key pair.
STORAGE_ENDPOINT=http://minio:9000
# R2 ignores the region; "auto" is what its own documentation uses.
STORAGE_REGION=auto
# Bucket holding every clinic's files. Keys are prefixed per clinic and patient.
STORAGE_BUCKET=clinic-files
# Development-only credentials; they also become the MinIO root user/password.
STORAGE_ACCESS_KEY_ID=clinic_dev_access_key
STORAGE_SECRET_ACCESS_KEY=clinic_dev_secret_key
# MinIO addresses buckets by path; R2 uses virtual-hosted style, so set this
# to false there.
STORAGE_FORCE_PATH_STYLE=true
# Lifetime of a presigned upload URL, in seconds.
STORAGE_UPLOAD_URL_TTL_SECONDS=300
# Lifetime of a signed download URL, in seconds. Kept short: these URLs point at
# medical images, so a leaked link expires quickly.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# Host ports for the MinIO API and its web console (dev stack only).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# ─────────────────────── Notifications ────────────────────────────

# How a message leaves the building. `log` writes it to `notifications_log` and
# the application log and sends nothing — the correct provider for every
# environment without a gateway, which is all of them today, and what lets the
# booking OTP flow work end to end with no credentials.
# `http` POSTs `{ to, channel, body }` as JSON to NOTIFICATIONS_HTTP_URL, which
# is the shape a local SMS gateway or a thin WhatsApp Business API adapter
# accepts. Neither is integrated yet.
NOTIFICATIONS_PROVIDER=log
# Required when NOTIFICATIONS_PROVIDER=http.
# NOTIFICATIONS_HTTP_URL=https://sms.example/send
# Sent as `Authorization: Bearer …` when present.
# NOTIFICATIONS_HTTP_TOKEN=
# A gateway that accepts a connection and never answers must not hold a booking
# request open, so the timeout is not optional.
NOTIFICATIONS_HTTP_TIMEOUT_MS=5000

# ────────────────────── Public booking ────────────────────────────

# Signs the opaque token in the "manage your booking" link. Deliberately not
# JWT_SECRET: this one is handed to an anonymous stranger and lives for weeks,
# where an access token is short-lived and belongs to signed-in staff. Falls
# back to JWT_SECRET when unset so development boots with one variable; set a
# separate value per deployed environment:
#   openssl rand -base64 48
# BOOKING_TOKEN_SECRET=
# Public origin the manage link points at, as the patient's phone will open it.
PUBLIC_BASE_URL=http://localhost:5173

# ──────────────────────────── Seeding ─────────────────────────────

# Password given to every account created by `pnpm seed`. Development only.
SEED_PASSWORD=ChangeMe123!

# `docker compose exec api pnpm seed` creates one clinic ("Al Nour Dental
# Clinic"), the dental specialty, and one account per role. Sign in at
# POST /auth/login with either the phone or the email as "identifier":
#
#   role          phone           email
#   admin         +963100000001   admin@clinic.local
#   doctor        +963100000002   doctor@clinic.local
#   receptionist  +963100000003   reception@clinic.local
#   technician    +963100000004   technician@clinic.local
#
# The password for all four is SEED_PASSWORD above. The seed prints this table
# once when it runs, and is safe to re-run.
#
# The seed also creates a dental procedure catalog and ten patients with
# medical histories, visits, procedures with FDI tooth marks and one treatment
# plan, so every patients endpoint has something to return.

# ───────────────────────────── Web ────────────────────────────────

# Host port that maps to the web container (5173 in dev, 80 in production).
WEB_PORT=5173
# Where the Vite dev server proxies /api during development.
API_PROXY_TARGET=http://api:3000
# API base path baked into the built frontend. `/api` keeps it same-origin:
# Vite proxies it in dev, nginx proxies it in production.
VITE_API_BASE_URL=/api

# ──────────────────────── Dev file watching ───────────────────────

# Inotify does not reliably cross a Docker bind mount; make watchers poll.
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
