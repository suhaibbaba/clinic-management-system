# Copy to .env: cp .env.example .env && docker compose up
# Development defaults, safe to commit. Never commit .env.

#   openssl rand -base64 48   # JWT_SECRET, BOOKING_TOKEN_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD, STORAGE_SECRET_ACCESS_KEY

# ─────────────────────────── PostgreSQL ───────────────────────────

POSTGRES_USER=clinic
# Dev only; use a strong password when deployed.
POSTGRES_PASSWORD=clinic_dev_password
POSTGRES_DB=clinic
# Host port for the container's 5432.
POSTGRES_PORT=5432

# ───────────────────────────── API ────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=3000
# Host port for the API container.
API_PORT=3000
HOST=0.0.0.0
# Use `localhost` instead of `postgres` when running the API outside Docker.
DATABASE_URL=postgres://clinic:clinic_dev_password@postgres:5432/clinic
DATABASE_POOL_MAX=10
# Optional least-privilege roles, see DEPLOY.md.
# MIGRATION_DATABASE_URL=postgres://clinic:clinic_dev_password@postgres:5432/clinic
# APP_DATABASE_ROLE=clinic_app
# APP_DATABASE_PASSWORD=CHANGE_ME_app_password
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Proxies trusted for X-Forwarded-For (names or CIDRs).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Per user, or per IP when signed out. THROTTLE_ENABLED=false turns limits off.
THROTTLE_LIMIT_PER_MINUTE=600
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Must cover /api/auth/refresh as the browser sees it.
AUTH_COOKIE_PATH=/
# auto | always | never. auto = Secure in production or over https.
AUTH_COOKIE_SECURE=auto
# lax | strict | none. none only for a frontend on another origin.
AUTH_COOKIE_SAMESITE=lax

# ─────────────────────── Object storage (R2) ──────────────────────

# MinIO locally. For R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# and STORAGE_FORCE_PATH_STYLE=false.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=auto
STORAGE_BUCKET=clinic-files
# Dev only; also the MinIO root user and password.
STORAGE_ACCESS_KEY_ID=clinic_dev_access_key
STORAGE_SECRET_ACCESS_KEY=clinic_dev_secret_key
STORAGE_FORCE_PATH_STYLE=true
# Presigned URL lifetimes, in seconds.
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# Clinic logo only: signed for a week, re-signed daily so it caches.
STORAGE_BRANDING_URL_TTL_SECONDS=604800
STORAGE_BRANDING_URL_WINDOW_SECONDS=86400
# Storage origin to preconnect to from the web page. Empty = none.
VITE_STORAGE_ORIGIN=
# Host ports for MinIO and its console (dev only).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# ─────────────────────── Notifications ────────────────────────────

# log | http | whatsapp. log sends nothing and writes to the log.
NOTIFICATIONS_PROVIDER=log
# For http: POSTs { to, channel, body } as JSON.
# NOTIFICATIONS_HTTP_URL=https://sms.example/send
# Sent as a Bearer token when set.
# NOTIFICATIONS_HTTP_TOKEN=
NOTIFICATIONS_HTTP_TIMEOUT_MS=5000
# For whatsapp: all three are needed, else the API falls back to log.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_API_VERSION=v21.0

# ───────────────────────── Email ──────────────────────────────────

# log | resend. log prints the email to the API log and sends nothing.
EMAIL_PROVIDER=log
# From https://resend.com, needed for resend.
# RESEND_API_KEY=re_...
# Its domain must be verified with the provider. resend.dev only reaches the key's owner.
EMAIL_FROM=Clinic <onboarding@resend.dev>
# Activation and reset links stay valid this long.
EMAIL_LINK_TTL_HOURS=48

# ─────────────────────── Sign-in options ──────────────────────────

# Google sign-in, off until both are set. Redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Passkeys use the PUBLIC_BASE_URL host. Override only for another host.
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# ────────────────────── Public booking ────────────────────────────

# Signs "manage your booking" links. Falls back to JWT_SECRET; set its own when deployed.
# BOOKING_TOKEN_SECRET=
# The web app's public address.
PUBLIC_BASE_URL=http://localhost:5173

# ───────────────────────── AI assistant ───────────────────────────

# log | openai. log answers with a fixed line and calls nobody.
AI_PROVIDER=openai
# Needed for openai. Stays on the server.
# OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
# Must stay none while the API uses Chat Completions.
AI_REASONING_EFFORT=none
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_MS=30000
# Past messages sent to the model.
AI_HISTORY_MESSAGES=60
# Tool-call rounds per question.
AI_MAX_TOOL_STEPS=5
# Questions per user per hour.
AI_RATE_LIMIT_PER_HOUR=30
# Tokens per clinic per day.
AI_DAILY_TOKEN_BUDGET=200000
# How long a drafted bulk message waits to be sent.
AI_PROPOSAL_TTL_MINUTES=15
# Clinic-local hour the daily automation runs.
AI_AUTOMATION_HOUR=9
# Encrypts keys saved in the assistant settings: openssl rand -base64 32
# SECRETS_MASTER_KEY=

# ──────────────────────────── Seeding ─────────────────────────────

# Password for every seeded account (dev only). Accounts: admin@, doctor@, reception@,
# technician@, doctor2@clinic.local. Rebuild from scratch with `pnpm db:reset`.
SEED_PASSWORD=ChangeMe123!

# false seeds the clinic's setup only — accounts, lookups, procedure catalog, labs and their
# work types, suppliers and items — with no demo patients or activity.
# SEED_DEMO=true

# ───────────────────────────── Web ────────────────────────────────

# Host port for the web container.
WEB_PORT=5173
# Where the Vite dev server sends /api. Can be a remote API.
API_PROXY_TARGET=http://api:3000
VITE_API_BASE_URL=/api

# ──────────────────────── Dev file watching ───────────────────────

# Poll for file changes across the Docker bind mount.
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
