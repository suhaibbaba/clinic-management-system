# Sandbox environment template.
#
# The server holds this repository at /opt/clinic/sandbox. Copy this template
# to /opt/clinic/sandbox/.env there and fill in real values:
#
#   cd /opt/clinic/sandbox
#   cp .env.sandbox.example .env && chmod 600 .env
#   $EDITOR .env
#
# `.env` is gitignored, so the deploy's `git reset --hard` never touches it.
#
# Compose reads this one file twice: as `env_file` for the containers, and as
# the project `.env` for the ${...} substitutions in docker-compose.sandbox.yml.
# It is never committed and never leaves the server — every value below is a
# PLACEHOLDER. Generate real secrets on the box:
#
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD, STORAGE_SECRET_ACCESS_KEY
#
# See DEPLOY.md for the full server setup.

# There is nothing to configure about images: they are built on this server
# from the checkout this file sits in, and tagged clinic-sandbox-api and
# clinic-sandbox-web. Which build is running is decided by which commit is
# checked out — see "Rolling back" in DEPLOY.md.

# ─────────────────────────── PostgreSQL ───────────────────────────

# The database has no host port — it is reachable only from this compose
# project's network — but use a real password anyway.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=clinic

# ───────────────────────────── API ────────────────────────────────

NODE_ENV=production
# Port inside the container. The host mapping (127.0.0.1:15000) is fixed in
# docker-compose.sandbox.yml because the VPS is shared.
PORT=3000
# Bind address INSIDE the container, so the web and host can reach it over the
# Docker network. The container's port is published to 127.0.0.1 only, so this
# never listens on a public interface.
HOST=0.0.0.0
# `postgres` is the compose service name; keep it in step with the credentials
# above.
DATABASE_URL=postgres://clinic:CHANGE_ME_postgres_password@postgres:5432/clinic
DATABASE_POOL_MAX=10
# Browser origins allowed to call the API. The web app is same-origin through
# the host nginx, so this is only needed for tools calling the API directly.
CORS_ORIGIN=https://clinic-sandbox.organza-moda.com
LOG_LEVEL=log
# At least 32 characters. Generate one per environment — never reuse the
# development placeholder from .env.example.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_PATH=/
APP_VERSION=0.1.0-sandbox

# ──────────────────────────── Seeding ─────────────────────────────

# When true, the API container runs `pnpm seed` after migrations on every boot.
# The seed is idempotent, so leaving it on is safe; turn it off once the
# sandbox holds data anyone cares about.
SEED_ON_BOOT=true
# Password given to every seeded account. This is a demo login on a public
# hostname — treat it as one, and change it before showing the sandbox to
# anyone outside the team.
SEED_PASSWORD=CHANGE_ME_seed_password

# ─────────────────────── Object storage (MinIO) ───────────────────

# THE PUBLIC S3 ENDPOINT, not the internal one.
#
# The API signs presigned upload and download URLs against this hostname and
# hands them to the browser, so it has to be the address the browser can
# reach — the host nginx in front of MinIO. Setting it to http://minio:9000
# would sign URLs for a hostname that only exists inside Docker.
#
# Two consequences, both handled in DEPLOY.md:
#   - the host nginx must pass the Host header through unchanged, or MinIO
#     rejects the signature
#   - the API's own calls (HeadObject on upload confirm) also go out to this
#     public hostname and back in through nginx
STORAGE_ENDPOINT=https://clinic-sandbox-s3.organza-moda.com
STORAGE_REGION=auto
STORAGE_BUCKET=clinic-files
# These also become the MinIO root credentials, so they are real secrets even
# though the console is not exposed.
STORAGE_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
# MinIO addresses buckets by path.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=300
# Short by design: these URLs point at medical images.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# ──────────────────────────── Backups ─────────────────────────────

# Nightly pg_dump into the clinic_backups volume, UTC, HH:MM.
BACKUP_AT_UTC=02:15
# Dumps older than this many days are deleted after each run.
BACKUP_KEEP_DAYS=7
