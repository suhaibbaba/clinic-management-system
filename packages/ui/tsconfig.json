{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@ui/*": ["./src/*"],
      /* The package consumes the shared one straight from source, as the web app does, so an edit
         in packages/shared type-checks here without a build. */
      "@shared/*": ["../shared/src/*"],
      "@clinic/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
