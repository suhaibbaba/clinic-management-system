{
  "name": "@clinic/ui",
  "version": "1.0.0",
  "private": true,
  "description": "The interface system: components, tokens and the theme contract a product overrides.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*.test": null,
    "./components/*": "./src/components/*.tsx",
    "./lib/*.test": null,
    "./lib/*": "./src/lib/*.ts",
    "./theme": "./src/theme/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "dependencies": {
    "@clinic/shared": "workspace:*"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
