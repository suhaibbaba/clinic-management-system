{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/database/migrate.ts",
        "src/database/seed.ts",
        "scripts/*.mjs",
        "test/**/*.{spec,e2e-spec,live-spec}.ts",
        "src/**/*.spec.ts",
        "test/no-database.global-setup.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/*.mjs"]
    },
    "apps/web": {
      "entry": ["src/booking/main.tsx", "scripts/*.mjs", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "vite/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@fontsource/tajawal", "@vitest/browser"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "exclude": ["duplicates"]
}
