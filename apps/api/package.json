{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "description": "Clinic management system API — NestJS on the Fastify adapter.",
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest build --watch & tsc-alias -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seed.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clinic/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.6",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.12.3",
    "nestjs-zod": "^5.5.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.6",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "tsc-alias": "^1.9.4",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@api/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "maxWorkers": 1,
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "testTimeout": 30000
  }
}
