{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "**/*.ttf",
        "outDir": "dist"
      },
      {
        "include": "database/seed/assets/**/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
